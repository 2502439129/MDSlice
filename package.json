{
  "name": "mdslice",
  "version": "1.7.0",
  "description": "把 Markdown 按标题切成章节块、一次只读一章的本地阅读器；本包提供零依赖的本地服务入口，可在任意项目目录里浏览其 md 文档",
  "keywords": [
    "markdown",
    "reader",
    "docs",
    "local-server"
  ],
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "mdslice": "bin/mdslice.js"
  },
  "files": [
    "bin/",
    "MDSlice.html",
    "css/",
    "js/",
    "README.md",
    "README-MDSlice.md",
    "MD结构说明.md",
    "数学公式示例.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2502439129/MDSlice.git"
  }
}
